<?xml version="1.0"?>
<sdf version="1.10">
  <world name="pick_place_classroom">
    <!-- Z-up, metres. Table top is at z = 0.725 m. -->
    <model name="table">
      <static>true</static>
      <pose>0.60 0 0.70 0 0 0</pose>
      <link name="top">
        <visual name="top_visual">
          <geometry><box><size>1.00 0.60 0.05</size></box></geometry>
          <material><diffuse>0.32 0.48 0.62 1</diffuse></material>
        </visual>
        <collision name="top_collision">
          <geometry><box><size>1.00 0.60 0.05</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="pick_box">
      <static>false</static>
      <pose>0.20 0.16 0.765 0 0 0</pose>
      <link name="body">
        <visual name="box_visual">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
          <material><diffuse>0.96 0.61 0.12 1</diffuse></material>
        </visual>
        <collision name="box_collision">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="obstacle">
      <static>true</static>
      <pose>0.64 0 0.805 0 0 0</pose>
      <link name="pillar">
        <visual name="pillar_visual">
          <geometry><box><size>0.08 0.10 0.16</size></box></geometry>
          <material><diffuse>0.82 0.25 0.23 1</diffuse></material>
        </visual>
        <collision name="pillar_collision">
          <geometry><box><size>0.08 0.10 0.16</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="destination">
      <static>true</static>
      <pose>0.84 -0.16 0.735 0 0 0</pose>
      <link name="pad">
        <visual name="pad_visual">
          <geometry><cylinder><radius>0.06</radius><length>0.02</length></cylinder></geometry>
          <material><diffuse>0.23 0.68 0.45 1</diffuse></material>
        </visual>
        <collision name="pad_collision">
          <geometry><cylinder><radius>0.06</radius><length>0.02</length></cylinder></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
