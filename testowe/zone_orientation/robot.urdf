<?xml version="1.0"?>
<robot name="orientation_gantry">
  <link name="base_link">
    <visual><origin xyz="-0.12 0 0.07"/><geometry><box size="0.08 0.12 0.06"/></geometry><material name="base_blue"><color rgba="0.16 0.30 0.47 1"/></material></visual>
    <collision><origin xyz="-0.12 0 0.07"/><geometry><box size="0.08 0.12 0.06"/></geometry></collision>
  </link>
  <link name="x_carriage">
    <visual><origin xyz="0 0 0.08"/><geometry><box size="0.08 0.08 0.04"/></geometry><material name="rail_blue"><color rgba="0.27 0.53 0.70 1"/></material></visual>
    <collision><origin xyz="0 0 0.08"/><geometry><box size="0.08 0.08 0.04"/></geometry></collision>
  </link>
  <link name="y_carriage">
    <visual><origin xyz="0 0 0.045"/><geometry><box size="0.04 0.04 0.04"/></geometry><material name="torch_dark"><color rgba="0.22 0.25 0.29 1"/></material></visual>
    <collision><origin xyz="0 0 0.045"/><geometry><box size="0.04 0.04 0.04"/></geometry></collision>
  </link>
  <link name="wrist_link">
    <visual><origin xyz="0.035 0 0.03"/><geometry><box size="0.07 0.02 0.02"/></geometry><material name="wrist_orange"><color rgba="0.93 0.42 0.12 1"/></material></visual>
    <collision><origin xyz="0.035 0 0.03"/><geometry><box size="0.07 0.02 0.02"/></geometry></collision>
  </link>
  <link name="tcp_link">
    <visual><geometry><sphere radius="0.008"/></geometry><material name="tip_red"><color rgba="0.94 0.31 0.20 1"/></material></visual>
    <collision><geometry><sphere radius="0.008"/></geometry></collision>
  </link>
  <joint name="slide_x" type="prismatic">
    <parent link="base_link"/><child link="x_carriage"/><origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="0" upper="0.8" effort="100" velocity="0.5"/>
  </joint>
  <joint name="slide_y" type="prismatic">
    <parent link="x_carriage"/><child link="y_carriage"/><origin xyz="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-0.25" upper="0.25" effort="100" velocity="0.5"/>
  </joint>
  <joint name="wrist_yaw" type="revolute">
    <parent link="y_carriage"/><child link="wrist_link"/><origin xyz="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="50" velocity="1.5"/>
  </joint>
  <joint name="tcp_mount" type="fixed">
    <parent link="wrist_link"/><child link="tcp_link"/><origin xyz="0 0 0"/>
  </joint>
</robot>
