<?xml version="1.0"?>
<robot name="four_bar">
  <!-- A planar four-bar represented as a tree. C_left and C_right are two
       separate URDF links; kinematic-constraints.json closes their XY pin. -->
  <link name="base">
    <visual><origin xyz="0.275 0 -0.09"/><geometry><box size="0.64 0.055 0.04"/></geometry>
      <material name="ground"><color rgba="0.22 0.29 0.42 1"/></material></visual>
    <!-- Visual-only hinge pins bridge the separated bar layers. They do not
         change the cut-tree topology or the planner's collision geometry. -->
    <visual><origin xyz="0 0 -0.005"/><geometry><cylinder radius="0.012" length="0.20"/></geometry>
      <material name="input_pivot"><color rgba="0.16 0.19 0.23 1"/></material></visual>
    <visual><origin xyz="0.55 0 -0.04"/><geometry><cylinder radius="0.012" length="0.15"/></geometry>
      <material name="output_pivot"><color rgba="0.16 0.19 0.23 1"/></material></visual>
    <collision><origin xyz="0.275 0 -0.09"/><geometry><box size="0.64 0.055 0.04"/></geometry></collision>
  </link>
  <link name="input_link">
    <visual><origin xyz="0.11 0 0.07"/><geometry><box size="0.22 0.035 0.025"/></geometry>
      <material name="input_color"><color rgba="0.97 0.45 0.13 1"/></material></visual>
    <visual><origin xyz="0.22 0 0.095"/><geometry><cylinder radius="0.012" length="0.10"/></geometry>
      <material name="coupler_pivot"><color rgba="0.16 0.19 0.23 1"/></material></visual>
    <collision><origin xyz="0.11 0 0.07"/><geometry><box size="0.22 0.035 0.025"/></geometry></collision>
  </link>
  <link name="coupler_link">
    <visual><origin xyz="0.24 0 0.12"/><geometry><box size="0.48 0.032 0.025"/></geometry>
      <material name="coupler_color"><color rgba="0.95 0.73 0.17 1"/></material></visual>
    <visual><origin xyz="0.48 0 0.07"/><geometry><cylinder radius="0.012" length="0.16"/></geometry>
      <material name="closure_pivot"><color rgba="0.16 0.19 0.23 1"/></material></visual>
    <collision><origin xyz="0.24 0 0.12"/><geometry><box size="0.48 0.032 0.025"/></geometry></collision>
  </link>
  <link name="C_left"/>
  <link name="output_link">
    <visual><origin xyz="0.16 0 0.02"/><geometry><box size="0.32 0.038 0.025"/></geometry>
      <material name="output_color"><color rgba="0.19 0.72 0.74 1"/></material></visual>
    <collision><origin xyz="0.16 0 0.02"/><geometry><box size="0.32 0.038 0.025"/></geometry></collision>
  </link>
  <link name="C_right"/>

  <joint name="input" type="revolute">
    <parent link="base"/><child link="input_link"/><origin xyz="0 0 0"/>
    <axis xyz="0 0 1"/><limit lower="0.35" upper="1.2" effort="20" velocity="0.8"/>
  </joint>
  <joint name="coupler" type="revolute">
    <parent link="input_link"/><child link="coupler_link"/><origin xyz="0.22 0 0"/>
    <axis xyz="0 0 1"/><limit lower="-1.05" upper="0.25" effort="20" velocity="1.6"/>
  </joint>
  <joint name="left_pin" type="fixed">
    <parent link="coupler_link"/><child link="C_left"/><origin xyz="0.48 0 0"/>
  </joint>
  <joint name="output" type="revolute">
    <parent link="base"/><child link="output_link"/><origin xyz="0.55 0 0"/>
    <axis xyz="0 0 1"/><limit lower="1.25" upper="1.7" effort="20" velocity="0.8"/>
  </joint>
  <joint name="right_pin" type="fixed">
    <parent link="output_link"/><child link="C_right"/><origin xyz="0.32 0 0"/>
  </joint>
</robot>
