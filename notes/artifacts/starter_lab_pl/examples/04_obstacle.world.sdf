<?xml version="1.0"?>
<sdf version="1.10">
  <world name="weld_classroom">
    <!-- Plate top is z=-0.025 m. The TCP seam is 0.025 m above it. -->
    <model name="workpiece">
      <static>true</static>
      <pose>0.35 0.05 -0.075 0 0 0</pose>
      <link name="plate">
        <visual name="plate_visual">
          <geometry><box><size>0.60 0.50 0.10</size></box></geometry>
          <material><diffuse>0.53 0.59 0.66 1</diffuse></material>
        </visual>
        <collision name="plate_collision">
          <geometry><box><size>0.60 0.50 0.10</size></box></geometry>
        </collision>
      </link>
    </model>
    <!-- A separate plate touching the parent at x=0.65 m, initially unjoined. -->
    <model name="extension_plate">
      <static>true</static>
      <pose>0.75 0.05 -0.075 0 0 0</pose>
      <link name="plate">
        <visual name="extension_visual">
          <geometry><box><size>0.20 0.50 0.10</size></box></geometry>
          <material><diffuse>0.78 0.43 0.24 1</diffuse></material>
        </visual>
        <collision name="extension_collision">
          <geometry><box><size>0.20 0.50 0.10</size></box></geometry>
        </collision>
      </link>
    </model>
  <model name="lab_obstacle"><static>true</static><pose>0.35 0.14 0 0 0 0</pose><link name="body"><visual name="visible"><geometry><box><size>0.05 0.05 0.10</size></box></geometry><material><diffuse>0.85 0.15 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.05 0.05 0.10</size></box></geometry></collision></link></model>
</world>
</sdf>
