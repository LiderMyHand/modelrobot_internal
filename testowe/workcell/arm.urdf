<?xml version="1.0"?>
<robot name="classroom_six_axis_arm">
  <!-- Z-up, metres/radians. All geometry is primitive and local. -->
  <link name="base_link">
    <visual><origin xyz="0 0 0.10"/><geometry><box size="0.20 0.20 0.20"/></geometry><material name="base"><color rgba="0.20 0.25 0.31 1"/></material></visual>
    <collision><origin xyz="0 0 0.10"/><geometry><box size="0.20 0.20 0.20"/></geometry></collision>
  </link>
  <link name="column_link">
    <visual><origin xyz="0 0 0.375"/><geometry><box size="0.11 0.11 0.75"/></geometry><material name="column"><color rgba="0.34 0.44 0.57 1"/></material></visual>
    <collision><origin xyz="0 0 0.375"/><geometry><box size="0.11 0.11 0.75"/></geometry></collision>
  </link>
  <link name="upper_arm_link">
    <visual><origin xyz="0.19 0 0"/><geometry><box size="0.38 0.09 0.09"/></geometry><material name="upper"><color rgba="0.95 0.62 0.15 1"/></material></visual>
    <collision><origin xyz="0.19 0 0"/><geometry><box size="0.38 0.09 0.09"/></geometry></collision>
  </link>
  <link name="forearm_link">
    <visual><origin xyz="0.16 0 0"/><geometry><box size="0.32 0.075 0.075"/></geometry><material name="forearm"><color rgba="0.94 0.73 0.28 1"/></material></visual>
    <collision><origin xyz="0.16 0 0"/><geometry><box size="0.32 0.075 0.075"/></geometry></collision>
  </link>
  <link name="wrist_roll_link">
    <visual><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.09 0.09"/></geometry><material name="wrist"><color rgba="0.24 0.61 0.77 1"/></material></visual>
    <collision><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.09 0.09"/></geometry></collision>
  </link>
  <link name="wrist_pitch_link">
    <visual><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.08 0.08"/></geometry><material name="wrist"><color rgba="0.24 0.61 0.77 1"/></material></visual>
    <collision><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.08 0.08"/></geometry></collision>
  </link>
  <link name="wrist_final_link">
    <visual><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.07 0.07"/></geometry><material name="wrist"><color rgba="0.24 0.61 0.77 1"/></material></visual>
    <collision><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.07 0.07"/></geometry></collision>
  </link>
  <link name="tcp_link">
    <visual><geometry><sphere radius="0.025"/></geometry><material name="tcp"><color rgba="0.11 0.80 0.65 1"/></material></visual>
    <collision><geometry><sphere radius="0.025"/></geometry></collision>
  </link>

  <joint name="base_yaw" type="revolute">
    <parent link="base_link"/><child link="column_link"/><origin xyz="0 0 0.20"/><axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="1.5"/>
  </joint>
  <joint name="shoulder_pitch" type="revolute">
    <parent link="column_link"/><child link="upper_arm_link"/><origin xyz="0 0 0.75"/><axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.5" effort="100" velocity="1.2"/>
  </joint>
  <joint name="elbow_pitch" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/><origin xyz="0.38 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.4" upper="2.4" effort="100" velocity="1.5"/>
  </joint>
  <joint name="wrist_roll" type="revolute">
    <parent link="forearm_link"/><child link="wrist_roll_link"/><origin xyz="0.32 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="2.0"/>
  </joint>
  <joint name="wrist_pitch" type="revolute">
    <parent link="wrist_roll_link"/><child link="wrist_pitch_link"/><origin xyz="0.08 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="50" velocity="2.0"/>
  </joint>
  <joint name="wrist_final" type="revolute">
    <parent link="wrist_pitch_link"/><child link="wrist_final_link"/><origin xyz="0.08 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="2.0"/>
  </joint>
  <joint name="tcp_mount" type="fixed">
    <parent link="wrist_final_link"/><child link="tcp_link"/><origin xyz="0.08 0 0"/>
  </joint>
</robot>
